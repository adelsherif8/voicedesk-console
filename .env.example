# Copy to .env.local to override. Vite only exposes variables prefixed with VITE_.

# Where the console loads the eval snapshot from: JSON shaped { history, latest },
# exactly what voicedesk's evals/publish.py writes to evals/results/published.json.
#   development / CI : /fixtures/published.json   (frozen copy in public/, deterministic)
#   staging (Vercel Preview)    : /fixtures/published.json
#   production (Vercel Production): https://raw.githubusercontent.com/adelsherif8/voicedesk/master/evals/results/published.json
VITE_EVALS_URL=/fixtures/published.json

# Shown as a badge in the header: development | ci | staging | production
VITE_APP_ENV=development
